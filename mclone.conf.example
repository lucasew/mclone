[tools]

# tool sources provide server-side tools to the toolbox provider
# each tool source produces one or more tools that the LLM can call
# use tool_name option to customize the name exposed to the LLM

[tools.search]
type = 'duckduckgo'
export = true

# [tools.search.options]
# max_results = 5
# tool_name = 'WebSearch'  # default

[tools.webfetch]
type = 'webfetch'
export = true

# [tools.webfetch.options]
# timeout = '30s'
# max_redirects = 5
# max_body_size = 2097152  # 2 MiB
# tool_name = 'WebFetch'  # default

[remotes]

# the toolbox provider wraps a base provider and adds server-side tools
# mclone serve assistant
[remotes.assistant]
type = 'toolbox'
export = true

[remotes.assistant.options]
provider = 'models'
tools = ['search', 'webfetch']
# max_loops = 20

[remotes.gemini]
type = 'antigravity'
export = true

[remotes.gemini.options]
token = '# token generated by mclone config'

[remotes.modal]
type = 'openai'
export = true

# modal has GLM 5 free for a limited time
[remotes.modal.options]
api_key = 'modalresearch_TAKE_FROM_THE_SITE'
base_url = 'https://api.us-west-2.modal.direct/v1'

# the route provider maps model slugs to remote:model pairs
# when a client requests "claude-opus-4-6", route resolves it
# to the configured remote and backend model
# format: 'slug' = 'remote:backend_model'
[remotes.models]
type = 'route'
export = true

[remotes.models.options]
# claude-haiku-4-5-20251001 = 'gemini:gemini-3-flash-preview'
# claude-opus-4-6 = 'gemini:gemini-3-pro-preview'
# claude-sonnet-4-5-20250929 = 'gemini:gemini-3-flash-preview'
claude-haiku-4-5-20251001 = 'modal:zai-org/GLM-5-FP8'
claude-opus-4-6 = 'modal:zai-org/GLM-5-FP8'
claude-sonnet-4-5-20250929 = 'modal:zai-org/GLM-5-FP8'

[remotes.whiterun]
type = 'ollama'
export = true

[remotes.whiterun.options]
base_url = 'http://whiterun:11434'
